---
// The empty, positioned div that the page's own iWeb script fills with the
// photo grid (IWLayoutPhotoGrid). Its geometry is inline and load-bearing: the
// grid script reads `photogrid.style.top` and writes `style.height` back, and
// IWSetSpacerHeight() grows the layer's last `.spacer` to match.
import type { GridItem } from '../engine/types';
import { styleOf } from '../engine/geometry';

interface Props {
  item: GridItem;
}

const { item } = Astro.props;
---

<div id={item.id} style={styleOf(item.box)}></div>
