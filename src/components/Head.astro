---
// The page <head>, in the archive's own order: metas, title, the page's iWeb
// stylesheet, IE conditional comments, the three widget stylesheet imports, the
// RSS link and the shared iWeb scripts (ending with this page's own script).
import type { Page } from '../engine/types';
import { pageStylesheet, widgetStylesheet } from '../engine/styles';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const { head } = page;
---

{head.items.map((item) =>
  item.k === 'meta' ? (
    <meta {...item.attrs} />
  ) : item.k === 'title' ? (
    <title>{item.text}</title>
  ) : item.k === 'pageCss' ? (
    <link {...item.attrs} href={pageStylesheet(page.key)} />
  ) : item.k === 'widgetCss' ? (
    <style {...item.attrs} set:html={`<!--\n    @import "${widgetStylesheet(item.name)}";\n-->`} />
  ) : item.k === 'link' ? (
    <link {...item.attrs} />
  ) : item.k === 'comment' ? (
    <Fragment set:html={`<!--${item.text}-->`} />
  ) : item.k === 'style' ? (
    <style {...item.attrs} set:html={item.text} />
  ) : (
    <script type="text/javascript" src={item.src} is:inline></script>
  )
)}
