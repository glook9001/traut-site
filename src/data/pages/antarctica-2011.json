        },
        {
         "tag": "p",
         "attrs": {
          "class": "paragraph_style"
         },
         "c": [
          {
           "tag": "br"
          }
         ]
        },
        {
         "tag": "#text",
         "v": "\n                "
        },
        {
         "tag": "p",
         "attrs": {
          "class": "paragraph_style"
         },
         "c": [
          {
           "tag": "br"
          }
         ]
        },
        {
         "tag": "#text",
         "v": "\n                "
        },
        {
         "tag": "p",
         "attrs": {
          "class": "paragraph_style"
         },
         "c": [
          {
           "tag": "br"
          }
         ]
        },
        {
         "tag": "#text",
         "v": "\n                "
        },
        {
         "tag": "p",
         "attrs": {
          "style": "padding-bottom: 0pt; ",
          "class": "paragraph_style"
         },
         "c": [
          {
           "tag": "a",
           "attrs": {
            "title": "Antarctic_Peninsula.html",
            "href": "/antarctic-peninsula"
           },
           "c": [
            {
             "tag": "#text",
             "v": "Antarctic Peninsula"
            }
           ]
          },
          {
           "tag": "#text",
           "v": " — I had visited the peninsula several years earlier, so I knew what to expect for this part of the trip, but I was once again struck by the beauty of the place."
          },
          {
           "tag": "br"
          }
         ]
        },
        {
