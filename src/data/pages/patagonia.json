         },
         "c": [
          {
           "tag": "#text",
           "v": "I was on a 17-day photo tour with Joseph Van Os "
          },
          {
           "tag": "a",
           "attrs": {
            "class": "class2",
            "title": "http://www.photosafaris.com",
            "href": "http://www.photosafaris.com"
