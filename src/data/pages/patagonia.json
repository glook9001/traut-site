           "c": [
            {
             "tag": "#text",
             "v": "photo safaris"
            }
           ]
          },
          {
           "tag": "#text",
           "v": ". Our tour started in Punta Arenas, Chile. We visited the Los Glaciares National Park in Argentina and Torres del Paine National Park in Chile."
          },
          {
           "tag": "br"
          }
         ]
        },
        {
         "tag": "#text",
         "v": "\n                "
        },
