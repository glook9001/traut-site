---
import { getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';

// `/` is the archive's Welcome.html, not an invented index page.
const entry = await getEntry('pages', 'index');
if (!entry) throw new Error('no ported Welcome page (src/content/pages/index.json)');
const page = entry.data;
---

<Page page={page} />
