---
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';

// One route per archive page. The entries are generated from Traut.com by
// scripts/extract_pages.py and validated against src/content.config.ts.
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((entry) => entry.id !== 'index')
    .map((entry) => ({ params: { slug: entry.id }, props: { page: entry.data } }));
}

const { page } = Astro.props;
---

<Page page={page} />
