     "contentCls": "text-content style_External_330_72",
     "contentStyle": "padding: 0px; ",
     "nodes": [
      {
       "tag": "#text",
       "v": "\n              "
      },
      {
       "tag": "div",
       "attrs": {
        "class": "style_1"
       },
       "c": [
        {
         "tag": "#text",
         "v": "\n                "
        },
        {
         "tag": "p",
         "attrs": {
          "style": "padding-top: 0pt; ",
          "class": "paragraph_style_3"
         },
         "c": [
          {
           "tag": "#text",
           "v": "The photo above shows a typical Zodiac landing in Antarctica. This particular landing was at Cuverville Island. The ship can be seen in the upper right."
          },
          {
           "tag": "br"
          }
         ]
        },
        {
         "tag": "#text",
         "v": "\n              "
        }
       ]
      },
      {
       "tag": "#text",
       "v": "\n            "
      }
     ]
